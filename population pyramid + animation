import matplotlib.animation as animation

def save_population_pyramid_animation(years, start_year, male_array, female_array, total_array, filename):
    """
    Creates and saves an animated population pyramid across multiple years.

    Parameters:
        years (list or np.ndarray): Years to include in the animation.
        start_year (int): First year represented in the arrays.
        male_array (np.ndarray): 2D array of male population counts by year and age.
        female_array (np.ndarray): 2D array of female population counts by year and age.
        total_array (np.ndarray): 2D array of total population counts by year and age.
        filename (str): Name of the GIF file to save.

    Returns:
        None
    """
    ages = np.arange(male_array.shape[1])
    x_limit = 100000 # Use 100,000 as a common x-axis limit since the maximum population is approximately 92,938.

    fig, ax = plt.subplots(figsize=(8, 10))

    def update(year):
        ax.clear()

        male_pct, female_pct = get_population_percent(
            year, start_year, male_array, female_array, total_array
        )

        ax.barh(ages, female_pct, label="Female")
        ax.barh(ages, male_pct, left=-male_pct, label="Male")

        ax.axvline(0, color="black")
        ax.set_xlim(-x_limit, x_limit)
        ax.set_ylim(0, ages[-1])

        ax.set_xlabel("Percent of Total Population")
        ax.set_ylabel("Age")
        ax.set_title(f"Denmark Population Pyramid, {year}")
        ax.legend(loc="upper right")

    anim = animation.FuncAnimation(
        fig,
        update,
        frames=years,
        interval=300,
        repeat=True
    )

    anim.save(filename, writer="pillow", fps=3)
    plt.close(fig)


animation_years = np.arange(1835, 2026, 5)

if animation_years[-1] != 2025:
    animation_years = np.append(animation_years, 2025)

save_population_pyramid_animation(
    animation_years,
    1835,
    male_pop_array,
    female_pop_array,
    total_pop_array,
    "denmark_population_pyramid.gif"
)


